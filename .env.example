# ================================================================
# Metabo Drops — Environment Configuration
# ================================================================
# TWO WAYS TO USE THIS:
#
# Option A — Hostinger (recommended):
#   Panel → Websites → Your Site → Settings → Environment Variables
#   Add each variable directly. No file upload needed.
#
# Option B — Other hosting / File Manager:
#   Fill in values below → upload this file to project root folder
#   Restart Node.js app after upload.
# ================================================================

# Pre-filled — do not change
NEXT_PUBLIC_SITE_URL=https://metabbodrops.com

# ── Google Search Console ──────────────────────────────────────
# 1. search.google.com/search-console → Add property → URL prefix
# 2. Verification: HTML tag → copy ONLY the content="..." value
# 3. Paste below (without quotes)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── Bing Webmaster Tools ───────────────────────────────────────
# 1. bing.com/webmasters → Add site → HTML meta tag method
# 2. Copy ONLY the content="..." value → paste below
NEXT_PUBLIC_BING_VERIFICATION=

# ── IndexNow (Bing Instant Indexing) ──────────────────────────
# 1. bing.com/indexnow/getstarted → generate key
# 2. Paste below — site will ping Bing automatically on first visit
NEXT_PUBLIC_INDEXNOW_KEY=

# ================================================================
# Keep this file private. Do not commit to public repositories.
# ================================================================
